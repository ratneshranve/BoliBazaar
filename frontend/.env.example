# One app on one port: user app at http://localhost:5173/  ·  admin panel at http://localhost:5173/admin
# Backend base URL including /api/v1 (required by both)
VITE_API_BASE_URL=http://localhost:5000/api/v1
# ISO-2 country used to parse phone numbers at login — user app (required)
VITE_DEFAULT_COUNTRY_CODE=IN
# Google Maps JS key (used by the Locations module, Phase 2)
VITE_GOOGLE_MAPS_API_KEY=
