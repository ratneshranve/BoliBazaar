# ───────── Core (required) ─────────
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (admin panel URLs)
CORS_ORIGINS=http://localhost:5173
# Public URL of this backend (used to build URLs of files stored on the VPS)
PUBLIC_BASE_URL=http://localhost:5000

MONGODB_URI=mongodb://127.0.0.1:27017/bolibazaar
REDIS_URL=redis://127.0.0.1:6379

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
USER_JWT_SECRET=
ADMIN_JWT_SECRET=
OTP_HASH_SECRET=
USER_ACCESS_TOKEN_TTL=15m
USER_REFRESH_TOKEN_DAYS=60
ADMIN_ACCESS_TOKEN_TTL=8h

# ───────── VPS file storage (used when Admin › Storage = VPS) ─────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ───────── OTP / SMS ─────────
# msg91 | twilio | console   (console = prints OTP to server log, allowed ONLY when NODE_ENV=development)
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ───────── Firebase (FCM push) ─────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with \n for new lines, wrapped in double quotes
FIREBASE_PRIVATE_KEY=

# ───────── Cloudinary (used when Admin › Storage = Cloudinary) ─────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bolibazaar

# ───────── Razorpay (Phase 6) ─────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ───────── First super-admin (used once by: npm run seed:admin) ─────────
ADMIN_SEED_NAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
