# ───────── Core (required) ─────────
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (admin panel URLs)
CORS_ORIGINS=http://localhost:5173
# Address of the user website (for sitemap.xml / robots.txt), e.g. https://bolibazaar.in
PUBLIC_WEB_URL=
# Public address of THIS backend, no trailing slash. Photos stored on the VPS are saved in the DB as
# "/uploads/..." and the API adds this address in front, e.g. https://api.bolibazaar.in/uploads/listing/2026-10/<id>.webp
# On the VPS set it to the real domain; changing it later does not break old photos.
PUBLIC_BASE_URL=http://localhost:5000

MONGODB_URI=mongodb://127.0.0.1:27017/bolibazaar

# ───────── Redis & background jobs (both must be "true" or "false") ─────────
# REDIS_ENABLED=true  → real Redis (REDIS_URL required): rate limits, idempotency, caches shared across instances.
# REDIS_ENABLED=false → in-process memory instead: fine for one local instance; state is lost on restart.
REDIS_ENABLED=false
# Format: redis://:PASSWORD@host:6379   (or rediss:// for TLS)
REDIS_URL=
# BULLMQ_ENABLED=true needs REDIS_ENABLED=true. Queues are used from Phase 4/5 (notifications, auction closing).
BULLMQ_ENABLED=false

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
USER_JWT_SECRET=
ADMIN_JWT_SECRET=
OTP_HASH_SECRET=
USER_ACCESS_TOKEN_TTL=15m
USER_REFRESH_TOKEN_DAYS=60
ADMIN_ACCESS_TOKEN_TTL=8h

# ───────── VPS file storage (used when Admin › Storage = VPS) ─────────
# Folder for uploaded files (relative to where the backend starts, or an absolute path).
#   public photos  → <UPLOAD_DIR>/public/<folder>/<yyyy-mm>/<id>.webp, served at <PUBLIC_BASE_URL>/uploads/...
#   private files  → <UPLOAD_DIR>/private/... (ID documents, chat PDFs; never served publicly)
# On the VPS use an absolute folder OUTSIDE the code, so a redeploy (git pull / new release) never deletes photos,
# e.g. UPLOAD_DIR=/var/www/uploads   (make sure the backend user can write to it, and back it up).
# On Windows (local testing) "/var/www/uploads" means C:\var\www\uploads.
UPLOAD_DIR=/var/www/uploads
MAX_UPLOAD_MB=10

# ───────── OTP / SMS ─────────
# smsindiahub | msg91 | twilio | console   (console = prints OTP to server log, allowed ONLY when NODE_ENV=development)
SMS_PROVIDER=console
# Testing only: true = every login OTP is DEFAULT_OTP and no SMS is sent. Set false for real users.
DEFAULT_OTP_ENABLED=false
DEFAULT_OTP=1234
# SMS India Hub (SMS_PROVIDER=smsindiahub). Message must match your DLT template exactly; {{otp}} is replaced with the code.
# e.g. SMS_INDIA_HUB_OTP_MESSAGE=Welcome to the BoliBazaar powered by Appzeto.Your OTP for registration is {{otp}}.BGADEC
SMS_INDIA_HUB_API_KEY=
SMS_INDIA_HUB_SENDER_ID=
SMS_INDIA_HUB_USERNAME=
SMS_INDIA_HUB_DLT_TEMPLATE_ID=
SMS_INDIA_HUB_OTP_MESSAGE=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ───────── Firebase Admin (FCM push) ─────────
# The whole service-account JSON (Firebase console › Project settings › Service accounts › Generate new private key)
# on ONE line, wrapped in SINGLE quotes. Example shape: FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}'
FIREBASE_SERVICE_ACCOUNT=

# ───────── Cloudinary (used when Admin › Storage = Cloudinary) ─────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bolibazaar

# ───────── Automatic translation (Google Cloud Translation API v2) ─────────
# Needed to show Terms/Privacy/Support, category names and app text in the languages enabled in Admin › Languages.
GOOGLE_TRANSLATE_API_KEY=

# ───────── Google Maps Platform (server key) ─────────
# Enable "Places API (New)" and "Geocoding API" on the key. Restrict it to your server's IP.
# (The separate Maps SDK key for the Android app goes in apps/user-app/.env as GOOGLE_MAPS_API_KEY.)
GOOGLE_MAPS_SERVER_KEY=

# ───────── Razorpay (Phase 6) ─────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (SMTP). Used to verify a user's email and to send copies of important notifications.
# Leave empty to turn email off. Gmail: smtp.gmail.com, port 587, an App Password (not the account password).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Boli Bazaar <no-reply@example.com>"

# The first admin is NOT configured here. Create it with:  npm run seed:admin  (asks for name, email, password)
