# Copy to .env (debug builds) and .env.production (release builds). Never commit real values.
APP_ENV=development
# Backend base URL including /api/v1  (Android emulator → host machine: http://10.0.2.2:5000/api/v1)
API_BASE_URL=http://10.0.2.2:5000/api/v1
# Backend origin for sockets (Phase 4)
SOCKET_URL=http://10.0.2.2:5000
# Google Maps SDK key (Phase 2) — injected into AndroidManifest / AppDelegate from here
GOOGLE_MAPS_API_KEY=
# Default country used to parse phone numbers at login (ISO-2)
DEFAULT_COUNTRY_CODE=IN

# Firebase is configured through android/app/google-services.json and
# ios/BoliBazaar/GoogleService-Info.plist (download from Firebase console; not committed).
